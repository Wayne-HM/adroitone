# ─── Site ────────────────────────────────────────────────────────────────
# Canonical site URL (no trailing slash). Used for SEO metadata, sitemap, OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Contact form email delivery (production) ────────────────────────────
# Sign up at https://resend.com, verify your domain, then set:
RESEND_API_KEY=
# Where inquiries are delivered (must be on a verified Resend domain):
CONTACT_EMAIL=
# Optional custom "from" identity (defaults to Resend's onboarding sender):
CONTACT_FROM=

# ─── Analytics (optional) ────────────────────────────────────────────────
# When set, a privacy-friendly analytics script is loaded automatically.
NEXT_PUBLIC_ANALYTICS_ID=

# ─── Employee portal authentication ──────────────────────────────────────
# JWT signing secret for employee session cookies. REQUIRED in production.
# Generate a strong random value, e.g. `openssl rand -base64 32`.
# Never commit this file; set it in your deployment environment.
AUTH_JWT_SECRET=

# Admin secret guarding the demo-seeding endpoint (POST /api/seed).
# Only needed to seed demo/staging employee data. Not for production.
ADMIN_SEED_SECRET=

# When set to "1", enables the demo/staging employee experience with clearly
# labeled fictional accounts. Keep off in production.
EMPLOYEE_DEMO_MODE=
