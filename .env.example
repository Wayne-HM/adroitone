# ─── Site ────────────────────────────────────────────────────────────────
# Canonical site URL (no trailing slash). Used for SEO metadata, sitemap, OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Contact form email delivery (production) ────────────────────────────
# Sign up at https://resend.com, verify your domain, then set:
RESEND_API_KEY=
# Where inquiries are delivered (must be on a verified Resend domain):
CONTACT_EMAIL=
# Optional custom "from" identity (defaults to Resend's onboarding sender):
CONTACT_FROM=

# ─── Analytics (optional) ────────────────────────────────────────────────
# When set, a privacy-friendly analytics script is loaded automatically.
NEXT_PUBLIC_ANALYTICS_ID=
